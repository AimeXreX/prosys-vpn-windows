<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ProSyS design tokens, mirrored from the website / Telegram mini app
        (vpn-platform/public/home.css + miniapp-theme.css) and the Android app.
    -->
    <Color x:Key="PsBgColor">#050706</Color>
    <Color x:Key="PsSurfaceColor">#0B0F0C</Color>
    <Color x:Key="PsSurface2Color">#101712</Color>
    <Color x:Key="PsDeepColor">#0A2418</Color>
    <Color x:Key="PsInkColor">#F2F6F3</Color>
    <Color x:Key="PsMutedColor">#89948D</Color>
    <Color x:Key="PsAcidColor">#B8FF4D</Color>
    <Color x:Key="PsMintColor">#63FFBA</Color>
    <Color x:Key="PsAcidTextColor">#071109</Color>
    <Color x:Key="PsDangerColor">#FF716B</Color>

    <SolidColorBrush x:Key="PsBg" Color="{StaticResource PsBgColor}" />
    <SolidColorBrush x:Key="PsSurface" Color="{StaticResource PsSurfaceColor}" />
    <SolidColorBrush x:Key="PsSurface2" Color="{StaticResource PsSurface2Color}" />
    <SolidColorBrush x:Key="PsInk" Color="{StaticResource PsInkColor}" />
    <SolidColorBrush x:Key="PsMuted" Color="{StaticResource PsMutedColor}" />
    <SolidColorBrush x:Key="PsAcid" Color="{StaticResource PsAcidColor}" />
    <SolidColorBrush x:Key="PsMint" Color="{StaticResource PsMintColor}" />
    <SolidColorBrush x:Key="PsAcidText" Color="{StaticResource PsAcidTextColor}" />
    <SolidColorBrush x:Key="PsDanger" Color="{StaticResource PsDangerColor}" />
    <SolidColorBrush x:Key="PsLine" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PsLineSoft" Color="#0EFFFFFF" />

    <LinearGradientBrush x:Key="PsPrimaryGradient" StartPoint="0,0.4" EndPoint="1,0.6">
        <GradientStop Offset="0" Color="#CEFF73" />
        <GradientStop Offset="1" Color="#91F53F" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PsBrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#D7FF82" />
        <GradientStop Offset="1" Color="#8AF33E" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PsCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#12FFFFFF" />
        <GradientStop Offset="1" Color="#05FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PsHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0D1711" />
        <GradientStop Offset="1" Color="#080B09" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="PsHeroGlow" Center="1,0" GradientOrigin="1,0" RadiusX="0.7" RadiusY="0.9">
        <GradientStop Offset="0" Color="#24B6FF4C" />
        <GradientStop Offset="1" Color="#00B6FF4C" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="PsOrbBrush" Center="0.37,0.30" GradientOrigin="0.37,0.30" RadiusX="0.72" RadiusY="0.72">
        <GradientStop Offset="0" Color="#D9FF99" />
        <GradientStop Offset="0.18" Color="#71DD43" />
        <GradientStop Offset="0.49" Color="#163E2A" />
        <GradientStop Offset="0.68" Color="#07110B" />
        <GradientStop Offset="1" Color="#050706" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="PsCoreBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E1FFA7" />
        <GradientStop Offset="1" Color="#8CEE47" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PsQuotaBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#63FFBA" />
        <GradientStop Offset="1" Color="#B8FF4D" />
    </LinearGradientBrush>

    <FontFamily x:Key="PsFont">pack://application:,,,/Resources/Fonts/#Vazirmatn</FontFamily>

    <DropShadowEffect x:Key="PsAcidGlow" BlurRadius="28" Opacity="0.35" ShadowDepth="0" Color="#A8FF55" />
    <DropShadowEffect x:Key="PsSoftShadow" BlurRadius="40" Opacity="0.25" ShadowDepth="10" Color="#000000" />

    <!--  Card container used everywhere on the home screen  -->
    <Style x:Key="PsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PsCardGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource PsLineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource PsSoftShadow}" />
    </Style>

    <!--  Flat panel for the advanced (v2rayN) screen: no drop shadow so large lists stay fast  -->
    <Style x:Key="PsPanel" TargetType="Border">
        <Setter Property="Background" Value="#0B100D" />
        <Setter Property="BorderBrush" Value="{StaticResource PsLineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  Small square icon button used in the advanced toolbars  -->
    <Style x:Key="PsIconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource PsAcid}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Background="#0FB8FF4D"
                        BorderBrush="#33B8FF4D"
                        BorderThickness="1"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#26B8FF4D" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="#99B8FF4D" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#40B8FF4D" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Transparent splitter between advanced panels, with a faint grip on hover  -->
    <Style x:Key="PsSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#14B8FF4D" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Acid gradient pill, the site's .primary button  -->
    <Style x:Key="PsPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PsAcidText}" />
        <Setter Property="FontFamily" Value="{StaticResource PsFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="28,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{StaticResource PsPrimaryGradient}"
                        BorderBrush="#80DDFF9D"
                        BorderThickness="1"
                        CornerRadius="16"
                        Effect="{StaticResource PsAcidGlow}"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="sc" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Outlined acid button (.discount-field button / secondary actions)  -->
    <Style x:Key="PsGhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PsAcid}" />
        <Setter Property="FontFamily" Value="{StaticResource PsFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Padding="{TemplateBinding Padding}"
                        Background="#10B8FF4D"
                        BorderBrush="#55B8FF4D"
                        BorderThickness="1"
                        CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22B8FF4D" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="#AAB8FF4D" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Quiet text button for the top bar  -->
    <Style x:Key="PsQuietButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PsMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource PsFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Padding="{TemplateBinding Padding}"
                        Background="#05FFFFFF"
                        BorderBrush="{StaticResource PsLineSoft}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PsInk}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PsLine}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Rounded quota bar with gradient fill and glow  -->
    <Style x:Key="PsQuotaBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="#14FFFFFF" CornerRadius="5" />
                        <Border x:Name="PART_Track" />
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{StaticResource PsQuotaBrush}"
                            CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Opacity="0.55" ShadowDepth="0" Color="#9CFF41" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Switch for TUN mode  -->
    <Style x:Key="PsSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource PsInk}" />
        <Setter Property="FontFamily" Value="{StaticResource PsFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Grid Width="46" Height="26">
                            <Border
                                x:Name="track"
                                Background="#18FFFFFF"
                                BorderBrush="{StaticResource PsLine}"
                                BorderThickness="1"
                                CornerRadius="13" />
                            <Ellipse
                                x:Name="knob"
                                Width="18"
                                Height="18"
                                Margin="4,0"
                                HorizontalAlignment="Left"
                                Fill="{StaticResource PsMuted}" />
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="#33B8FF4D" />
                            <Setter TargetName="track" Property="BorderBrush" Value="#88B8FF4D" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource PsAcid}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
